# === Application ===
APP_ENV=development
APP_NAME=LedgerPilot
LOG_LEVEL=INFO

# === PostgreSQL + pgvector ===
POSTGRES_USER=ledgerpilot
POSTGRES_PASSWORD=ledgerpilot_dev_pass
POSTGRES_DB=ledgerpilot
DATABASE_URL=postgresql+asyncpg://ledgerpilot:ledgerpilot_dev_pass@localhost:5432/ledgerpilot
SYNC_DATABASE_URL=postgresql+psycopg://ledgerpilot:ledgerpilot_dev_pass@localhost:5432/ledgerpilot
CHECKPOINT_DATABASE_URL=postgresql://ledgerpilot:ledgerpilot_dev_pass@localhost:5432/ledgerpilot

# === LangGraph Security ===
LANGGRAPH_STRICT_MSGPACK=true

# === LLM Provider (Gemini Default) ===
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# === Security & RBAC Dev API Keys ===
WEBHOOK_HMAC_SECRET=lp_dev_hmac_secret_change_in_prod_9f8e7d6c
ADMIN_API_KEY=lp_admin_dev_key_001
CONTROLLER_API_KEY=lp_controller_dev_key_002
MANAGER_API_KEY=lp_manager_dev_key_003
CLERK_API_KEY=lp_clerk_dev_key_004

# === Enterprise ISO 20022 (pain.001) Settlement Engine ===
SETTLEMENT_MODE=iso20022
SETTLEMENT_OUTPUT_DIR=./settlements
DEBTOR_COMPANY_NAME=LedgerPilot Global Holdings Ltd
DEBTOR_IBAN=GB29NWBK60161331926819
DEBTOR_BIC=NWBKGB2L

# === Edge Orchestrator (n8n) ===
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook